{
  "formatVersion": 2,
  "buildOptions": {
    "useHMR": false,
    "keepServer": false,
    "buildMode": "prod",
    "buildEntry": "main.mjs",
    "useJs": true,
    "scriptEntry": "scripts/index.js",
    "scriptOutput": "scripts/index.js",
    "buildDir": "dev/",
    "dependencies": [
      { "module_name": "@minecraft/server", "version": "2.0.0" },
      { "module_name": "@minecraft/server-ui", "version": "2.0.0" }
    ],
    "resource": { "path": "res/", "resourceHints": true }
  },
  "versionType": "release"
}
