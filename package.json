{
  "name": "bedrock-cui",
  "version": "0.25.0",
  "description": "Minecraft 基岩版 JSON UI 的面向对象 UI 框架：一棵组件树 → 基岩版 JSON UI ＋ 浏览器预览（按游戏的排版规则画）＋ 静态检查；附带服务端表单的混合翻页、跨平台软换行与附加包打包",
  "keywords": [
    "minecraft",
    "bedrock",
    "json-ui",
    "ui",
    "addon",
    "mcaddon",
    "server-form",
    "scripting"
  ],
  "license": "MIT",
  "author": "OneFeiFan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneFeiFan/bedrock-cui.git"
  },
  "homepage": "https://github.com/OneFeiFan/bedrock-cui#readme",
  "bugs": {
    "url": "https://github.com/OneFeiFan/bedrock-cui/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./jsx-runtime": "./dist/core/jsx-runtime.js",
    "./web": "./dist/web/index.js",
    "./node": "./dist/node/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./package.json": "./package.json",
    "./dom": "./dist/dom/index.js",
    "./runtime/screens": "./dist/runtime/screens.js",
    "./runtime/core": "./dist/runtime/screenRuntime.js",
    "./internal": "./dist/internal.js",
    "./internal/server-pages": "./dist/runtime/serverPages.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "bin",
    "dist",
    "scripts/fetch-fonts.mjs",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node scripts/run-tests.mjs",
    "dev": "cd examples/cui_toggle_test && node ../../bin/bedrock-cui.mjs dev",
    "prepublishOnly": "npm test",
    "docs:api": "node scripts/gen-api-reference.mjs && node scripts/gen-component-api.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:site": "node scripts/build-site.mjs",
    "test-pack": "node examples/cui_toggle_test/build.mjs",
    "e2e": "node scripts/e2e-create.mjs"
  },
  "devDependencies": {
    "@minecraft/server": "^2.0.0",
    "@minecraft/server-ui": "^2.2.0",
    "@types/node": "^22.20.5",
    "marked": "^15.0.12",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "bedrock-cui": "bin/bedrock-cui.mjs"
  },
  "dependencies": {
    "sapdon": "^4.0.0",
    "vite": "^8.3.8"
  }
}
